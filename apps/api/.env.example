# Local Docker / desktop Postgres (not for production — do not reuse other apps' DBs)
DATABASE_URL=postgresql://postgres:password@localhost:5432/expense_tracker_dev

# Min 32 characters. In production, set a unique random secret in the Render dashboard
# (Blueprint can generate one). Never commit the real value.
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Render injects PORT automatically. Keep 3000 for local `pnpm run dev`.
PORT=3000
NODE_ENV=development

# Comma-separated browser origins for production CORS.
# Native Expo / React Native clients do not send Origin and are unaffected.
# Leave empty for mobile-only. Example: https://app.example.com
# Use * only if you intentionally allow all browser origins.
CORS_ORIGIN=
